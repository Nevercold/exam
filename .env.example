# Secret for session cookies, at least 32 characters: openssl rand -base64 32
NUXT_APP_SECRET=

# First admin, created on startup if the email doesn't exist yet
NUXT_ADMIN_EMAIL=
NUXT_ADMIN_PASSWORD=
NUXT_ADMIN_NAME=Admin

# SQLite file (inside the Docker image: file:/data/exam.db)
NUXT_DATABASE_URL=file:./data/exam.db

# Variant A (docker-compose.yml with Caddy): your domain
DOMAIN=exam.example.org

# Variant B (docker-compose.standalone.yml): address the app port is bound to
# BIND=127.0.0.1:3000

# Ed25519 key that signs student PDFs: pnpm keygen (keep it secret and back it up:
# without it, PDFs signed with it can't be verified anymore)
NUXT_SIGNING_PRIVATE_KEY=
NUXT_SIGNING_KEY_ID=k1
# After a key rotation: JSON with old public keys, e.g. {"k1":"MCowBQYDK2VwAyEA..."}
# NUXT_SIGNING_RETIRED_KEYS=

# Optional: AI grading suggestions via an OpenAI-compatible API (see docs/deployment.md).
# Answers (without names) are sent to this provider: check with your data protection officer first.
# NUXT_AI_BASE_URL=https://inference.hetzner.com/api/v1
# NUXT_AI_API_KEY=
# NUXT_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# NUXT_AI_REQUESTS_PER_MINUTE=10
